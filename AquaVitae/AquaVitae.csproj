<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>15</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
      <PackageReference Include="Tomlyn" Version="2.10.1" />
      <PackageReference Include="VectSharp" Version="2.6.1" />
      <PackageReference Include="VectSharp.Markdown" Version="1.7.0" />
      <PackageReference Include="VectSharp.PDF" Version="3.2.0" />
      <PackageReference Include="VectSharp.SVG" Version="1.10.3-a3" />
    </ItemGroup>

</Project>
